<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" alignment="CENTER_LEFT" spacing="12"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets top="9" right="14" bottom="9" left="14" />
  </padding>
  <VBox alignment="CENTER_LEFT" spacing="3" HBox.hgrow="ALWAYS">
    <HBox alignment="CENTER_LEFT" spacing="6">
      <Label fx:id="id" styleClass="contact-index" />
      <Label fx:id="name" maxWidth="Infinity" styleClass="contact-name" text="$first" HBox.hgrow="ALWAYS" />
    </HBox>
    <FlowPane fx:id="tags" hgap="5" vgap="3" />
  </VBox>
  <VBox alignment="CENTER_RIGHT" minWidth="94" spacing="2">
    <Label fx:id="phone" styleClass="contact-phone" text="$phone" />
    <Label text="View details" styleClass="contact-action" />
  </VBox>
</HBox>
