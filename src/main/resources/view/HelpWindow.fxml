<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.VBox?>
<?import javafx.stage.Stage?>

<fx:root title="Mentora Help" type="javafx.stage.Stage" minWidth="480" minHeight="360"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <icons>
    <Image url="@/images/help_icon.png" />
  </icons>
  <scene>
    <Scene>
      <stylesheets>
        <URL value="@HelpWindow.css" />
      </stylesheets>
      <VBox fx:id="helpMessageContainer" spacing="12" prefWidth="720" prefHeight="520">
        <padding>
          <Insets top="16" right="16" bottom="16" left="16" />
        </padding>
        <TextArea fx:id="helpContent" editable="false" wrapText="true" VBox.vgrow="ALWAYS" />
        <Label fx:id="helpMessage" wrapText="true" maxWidth="Infinity" />
        <Button fx:id="copyButton" mnemonicParsing="false" onAction="#copyUrl" text="Copy User Guide URL" />
      </VBox>
    </Scene>
  </scene>
</fx:root>
