<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" styleClass="list-panel">
  <HBox alignment="CENTER_LEFT" styleClass="panel-heading">
    <Label text="Configured groups" styleClass="section-title" />
    <Region HBox.hgrow="ALWAYS" />
    <Label fx:id="groupCountLabel" styleClass="record-count" />
  </HBox>
  <HBox alignment="CENTER_LEFT" styleClass="list-column-header">
    <Label text="CODE" minWidth="120" prefWidth="120" />
    <Label text="LABEL" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
    <Label text="KIND" minWidth="94" />
  </HBox>
  <ListView fx:id="groupListView" VBox.vgrow="ALWAYS" />
</VBox>
