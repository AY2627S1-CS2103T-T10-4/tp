@startuml
!include mentora-style.puml
class AddressBookParser
interface Parser<T> <<interface>>
class AssignGroupCommandParser
class AssignGroupCommand
abstract class Command <<abstract>>
class ArgumentTokenizer
class ArgumentMultimap

AddressBookParser ..> AssignGroupCommandParser : create
AssignGroupCommandParser .up.|> Parser
AssignGroupCommandParser ..> AssignGroupCommand : create
AssignGroupCommand --|> Command
AssignGroupCommandParser ..> ArgumentTokenizer : tokenizes arguments
AssignGroupCommandParser ..> ArgumentMultimap : reads values
ArgumentTokenizer ..> ArgumentMultimap : create
@enduml
