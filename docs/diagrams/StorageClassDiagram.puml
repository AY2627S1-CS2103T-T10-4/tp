@startuml
!include mentora-style.puml
interface Storage <<interface>>
class StorageManager
class JsonUserPrefsStorage
class JsonAddressBookStorage
class JsonSerializableAddressBook {
    +toModelType(): AddressBook
}
class JsonAdaptedStudent
class JsonAdaptedGuardian
class JsonAdaptedGroup
class JsonAdaptedGuardianLink
class JsonAdaptedGroupAssignment

StorageManager .up.|> Storage
StorageManager --> "1" JsonUserPrefsStorage : userPrefsStorage
StorageManager --> "1" JsonAddressBookStorage : addressBookStorage
JsonAddressBookStorage ..> JsonSerializableAddressBook : reads / creates for saving
JsonSerializableAddressBook "1" *-- "0..*" JsonAdaptedStudent : students
JsonSerializableAddressBook "1" *-- "0..*" JsonAdaptedGuardian : guardians
JsonSerializableAddressBook "1" *-- "0..*" JsonAdaptedGroup : groups
JsonSerializableAddressBook "1" *-- "0..*" JsonAdaptedGuardianLink : guardianLinks
JsonSerializableAddressBook "1" *-- "0..*" JsonAdaptedGroupAssignment : groupAssignments
@enduml
