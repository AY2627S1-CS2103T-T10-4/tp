@startuml
!include mentora-style.puml
class AddressBook
class Student
class Guardian
class StudentId
class GuardianId
class GroupAssignment
class GroupCatalogue
class Group
class GroupCode

AddressBook --> "0..*" Student : students
AddressBook --> "0..*" Guardian : guardians
AddressBook --> "0..*" GroupAssignment : assignments
AddressBook --> "1" GroupCatalogue : catalogue
GroupCatalogue --> "0..*" Group : groups
AddressBook ..> StudentId : guardian link keys
AddressBook ..> GuardianId : guardian link values
Student --> "1" StudentId : id
Guardian --> "1" GuardianId : id
GroupAssignment --> "1" StudentId : studentId
GroupAssignment --> "1" GroupCode : groupCode
Group --> "1" GroupCode : code
@enduml
