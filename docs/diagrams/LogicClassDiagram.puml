@startuml
!include mentora-style.puml
interface Logic <<interface>> {
    +execute(commandText: String): CommandResult
}
class LogicManager
class AddressBookParser {
    +parseCommand(userInput: String): Command
}
abstract class Command <<abstract>> {
    {abstract} +execute(model: Model): CommandResult
    +isReadOnly(): boolean
}
interface Model <<interface>>
interface Storage <<interface>>

LogicManager .up.|> Logic
LogicManager --> "1" AddressBookParser : parser
LogicManager --> "1" Model : model
LogicManager --> "1" Storage : storage
LogicManager ..> Command : executes
AddressBookParser ..> Command : returns
Command ..> Model : parameter
@enduml
