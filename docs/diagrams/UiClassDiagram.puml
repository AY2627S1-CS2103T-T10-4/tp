@startuml
!include mentora-style.puml
interface Ui <<interface>>
class UiManager
class MainWindow
abstract class UiPart<T> <<abstract>>
class StudentListPanel
class StudentDetailsPanel
interface Logic <<interface>>

UiManager .up.|> Ui
UiManager --> "0..1" MainWindow : mainWindow
UiManager --> "1" Logic : logic
MainWindow --> "1" Logic : logic
MainWindow --|> UiPart
MainWindow --> "0..1" StudentListPanel : studentListPanel
MainWindow --> "0..1" StudentDetailsPanel : studentDetailsPanel
StudentListPanel --|> UiPart
StudentDetailsPanel --|> UiPart
@enduml
