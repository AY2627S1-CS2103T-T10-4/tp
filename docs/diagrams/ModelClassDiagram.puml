@startuml
!include mentora-style.puml
interface Model <<interface>>
class ModelManager
class AddressBook
interface ReadOnlyAddressBook <<interface>>
class UserPrefs
interface ReadOnlyUserPrefs <<interface>>

ModelManager .up.|> Model
ModelManager "1" *--> "1" AddressBook : addressBook
ModelManager "1" *--> "1" UserPrefs : userPrefs
AddressBook .down.|> ReadOnlyAddressBook
UserPrefs .down.|> ReadOnlyUserPrefs
@enduml
